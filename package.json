{
  "name": "@lyyzka/lingxios",
  "version": "4.0.0-slim.0",
  "description": "Durable agent execution for PostgreSQL with fenced workers, native tools, verified outcomes, and sandboxed Python.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyyzka/LingxiOS.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist/src",
    "db/schema.sql",
    "db/schema-013.sql",
    "db/migrations/016-skill-delivery.sql",
    "kernel/runner.py"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./worker": {
      "types": "./dist/src/worker/index.d.ts",
      "import": "./dist/src/worker/index.js"
    },
    "./ui": {
      "types": "./dist/src/ui/index.d.ts",
      "import": "./dist/src/ui/index.js"
    }
  },
  "bin": {
    "lingxios-worker": "dist/src/worker/main.js",
    "lingxios-doctor": "dist/src/cli/doctor.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker": "node dist/src/worker/main.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0",
    "mammoth": "1.12.2",
    "pdfjs-dist": "6.3.289"
  },
  "dependencies": {
    "@streamparser/json": "0.0.26",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "peerDependencies": {
    "mammoth": "1.12.2",
    "pdfjs-dist": "6.3.289"
  },
  "peerDependenciesMeta": {
    "mammoth": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    }
  }
}
